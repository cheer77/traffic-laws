{
  "name": "traffic-laws",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24.12.0 <25",
    "pnpm": ">=10.34.7 <11"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@traffic-laws/studio",
    "dev:web": "turbo run dev --filter=@traffic-laws/web",
    "dev:studio": "turbo run dev --filter=@traffic-laws/studio",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@traffic-laws/web",
    "build:studio": "turbo run build --filter=@traffic-laws/studio",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . && turbo run lint",
    "test": "pnpm test:security && turbo run test",
    "test:security": "node --test tooling/eslint/glob-compatibility.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:imports": "pnpm --filter @traffic-laws/api db:generate && node scripts/check-imports.mjs",
    "check": "pnpm audit:imports && pnpm lint && pnpm test && pnpm typecheck && pnpm build && pnpm format:check",
    "dev:api": "turbo run dev --filter=@traffic-laws/api",
    "build:api": "turbo run build --filter=@traffic-laws/api",
    "test:api:integration": "pnpm --filter @traffic-laws/api test:integration",
    "test:admin:integration": "pnpm --filter @traffic-laws/api test:integration --admin",
    "dev:admin": "turbo run dev --filter=@traffic-laws/admin",
    "build:admin": "turbo run build --filter=@traffic-laws/admin"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "prettier": "3.9.10",
    "turbo": "2.11.9",
    "typescript": "5.9.3"
  }
}
