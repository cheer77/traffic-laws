{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tooling/**", ".npmrc", ".nvmrc"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "NODE_ENV",
        "PORT",
        "HOST",
        "CORS_ORIGINS",
        "SESSION_TTL_SECONDS",
        "SWAGGER_ENABLED"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "out/**", "dist/**"]
    },
    "typecheck": {
      "cache": false
    },
    "lint": {
      "outputs": [],
      "dependsOn": ["^lint"]
    },
    "test": {
      "outputs": [],
      "env": ["STUDIO_ASSET_REPORT", "STUDIO_ASSET_PREVIEW"],
      "dependsOn": ["^test"]
    }
  }
}
