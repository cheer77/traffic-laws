{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tooling/**", ".npmrc", ".nvmrc"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "out/**"]
    },
    "typecheck": {
      "cache": false
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": [],
      "env": ["STUDIO_ASSET_REPORT", "STUDIO_ASSET_PREVIEW"]
    }
  }
}
